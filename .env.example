# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase / PostgreSQL Database URLs
DATABASE_URL=postgresql://postgres.xxx:password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Embedding provider: 'local' (uses free local sentence-transformers) or 'gemini' (uses Google GenAI embeddings)
EMBEDDING_PROVIDER=local

# Relative path to the raw company CSV folder
DATA_DIR=leetcode-company-wise-problems-main

# Directory where ChromaDB SQLite tables and metadata will be saved
CHROMA_DB_DIR=data/chroma_db

# Directory where intermediate processed datasets will be saved
PROCESSED_DATA_DIR=data/processed

# Limit ingestion to Top 50 popular companies to speed up the process. Set to false to ingest all 470+ companies.
TOP_COMPANIES_ONLY=true
